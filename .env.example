# MediQueue environment configuration (copy to .env and edit).
MEDIQUEUE_HOST=0.0.0.0
MEDIQUEUE_PORT=8080

# IMPORTANT: set a long random value in production. It signs session cookies.
MEDIQUEUE_STORAGE_SECRET=please-change-this-to-a-long-random-string

# SQLite by default; PostgreSQL example:
# MEDIQUEUE_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/mediqueue
MEDIQUEUE_DATABASE_URL=sqlite:///data/mediqueue.db

# Change these PINs before exposing the app to a network.
MEDIQUEUE_ADMIN_PIN=1234
MEDIQUEUE_STAFF_PIN=5678

# Create three demo counters on a fresh database (1 = yes, 0 = no).
MEDIQUEUE_SEED_DEFAULTS=1
